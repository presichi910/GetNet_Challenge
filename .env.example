# --- Required API keys ---
GROQ_API_KEY=
TAVILY_API_KEY=
VOYAGE_API_KEY=

# --- Models (all overridable) ---
LLM_MODEL=openai/gpt-oss-120b
# Router, support and synthesizer use the light model; knowledge uses LLM_MODEL.
LIGHT_MODEL=openai/gpt-oss-20b
REASONING_EFFORT=low
# The judge should be a different model family than the generator to reduce self-preference bias.
JUDGE_MODEL=qwen/qwen3.8-27b
EMBEDDING_MODEL=voyage-3.5

# --- RAG ---
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=getnet_kb
RETRIEVAL_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Voyage free tier (no payment method) allows ~3 requests/min and 10K tokens/min.
# Lower the batch size and keep the sleep if you hit 429s during ingestion.
# With a payment method on file the limits are much higher: set sleep to 0 and batch to 128.
INGEST_BATCH_SIZE=16
INGEST_SLEEP_SECONDS=21

# --- App ---
LOG_LEVEL=INFO
