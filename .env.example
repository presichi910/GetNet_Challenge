# keys
# GROQ_API_KEY: the agents when AGENT_PROVIDER=groq, and always the eval judge
GROQ_API_KEY=
# FIREWORKS_API_KEY: the agents when AGENT_PROVIDER=fireworks
FIREWORKS_API_KEY=
TAVILY_API_KEY=
VOYAGE_API_KEY=

# provider of the agents (router, knowledge, support, synthesizer, summarizer): groq (default) or fireworks.
# fireworks uses its OpenAI-compatible API (https://api.fireworks.ai/inference/v1) with FIREWORKS_API_KEY.
# Fireworks serves gpt-oss-120b serverless but NOT gpt-oss-20b (it answers 404 "Model not found, inaccessible,
# and/or not deployed"), so with fireworks every role runs on the 120b. This is the configuration of the
# 2026-11-12 reports (latest.md, REPEATS-20261112.md):
#   AGENT_PROVIDER=fireworks
#   LLM_MODEL=accounts/fireworks/models/gpt-oss-120b
#   LIGHT_MODEL=accounts/fireworks/models/gpt-oss-120b
#   SUPPORT_MODEL=accounts/fireworks/models/gpt-oss-120b
# The eval judge (JUDGE_MODEL) always runs on Groq (GROQ_API_KEY), whatever this says.
# The values below are the Groq ones (the code default provider).
AGENT_PROVIDER=groq

# models, one variable per role (docker-compose.yml passes them to the containers)
# LLM_MODEL: knowledge agent
LLM_MODEL=openai/gpt-oss-120b
# LIGHT_MODEL: router and synthesizer
LIGHT_MODEL=openai/gpt-oss-20b
# SUPPORT_MODEL: support agent. Empty = same as LIGHT_MODEL. The 20b often skips get_recent_transactions
# on a decline and blames the terminal (eval case q08), the 120b does not. It shares the 120b quota
# with LLM_MODEL (Groq free tier: 8K tokens/min, 200K/day).
SUPPORT_MODEL=openai/gpt-oss-120b
REASONING_EFFORT=low
# JUDGE_MODEL: eval judge, use a different model family than the agents
JUDGE_MODEL=qwen/qwen3.8-27b
# Groq limits are per model. To run everything on one model set LLM_MODEL and LIGHT_MODEL to it
# (they then share one quota).
EMBEDDING_MODEL=voyage-3.5

# RAG
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=getnet_kb
RETRIEVAL_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Voyage free tier is ~3 requests/min. If you get 429s, keep these values.
# With a payment method on file: sleep 0, batch 128.
INGEST_BATCH_SIZE=16
INGEST_SLEEP_SECONDS=21

# auth (JWT, HS256). The app refuses to start if JWT_SECRET is empty, shorter than 32
# characters or looks like a placeholder. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret-of-32-or-more-chars
JWT_ISSUER=getnet-support-demo
JWT_AUDIENCE=getnet-support-api

# human handoff: the queue the operators work through (claim / reply). Its own file, apart from the
# conversation memory. HANDOFFS_FILE (jsonl) stays as an audit copy and is imported once into it.
HANDOFFS_DB_PATH=./data/handoffs.sqlite
# import the old queue file into the queue at startup (safe to leave on: records already there are
# skipped). Off by default: that file can hold test cases and old conversation excerpts. Back it up and
# clean it first, see the README, "Human oversight"
HANDOFF_IMPORT_JSONL=false
# an operator's claim holds this long; then the handoff is pending again (claiming again renews it)
HANDOFF_LEASE_MINUTES=15

# conversation memory: one SQLite file (in Docker it lives in the `data` volume)
CHECKPOINT_DB_PATH=./data/checkpoints.sqlite
# rolling summary: above this many messages the older ones are folded into a summary (LIGHT_MODEL).
# If the call fails or takes longer than the timeout, the turn goes on and the next turn retries.
SUMMARY_THRESHOLD=12
SUMMARY_TIMEOUT_SECONDS=20
# retention: the checkpoints hold customer data. A conversation idle for more than this many days is
# deleted (0 = never), at startup and every PURGE_INTERVAL_MINUTES.
THREAD_TTL_DAYS=30
PURGE_INTERVAL_MINUTES=60
# conversations per customer; a new one above the limit gets HTTP 429, nothing is deleted (0 = no limit)
MAX_THREADS_PER_USER=20

# observability: per-turn traces and spans (ids, tokens, cost, timings; never message text)
TRACES_DB_PATH=./data/traces.sqlite
# extra or corrected prices, JSON {model: [usd_per_1M_input, usd_per_1M_output]}; a model without a price
# is reported with cost null, never 0
MODEL_PRICES_JSON=
# a turn above either limit logs a WARNING line starting with "ALERT" (0 = off); a 429 always does
MAX_TURN_TOKENS=30000
MAX_TURN_COST_USD=0.02

# app
LOG_LEVEL=INFO
