# keys
GROQ_API_KEY=
TAVILY_API_KEY=
VOYAGE_API_KEY=

# models
LLM_MODEL=openai/gpt-oss-120b
# light model: router, support, synthesizer. LLM_MODEL: knowledge.
LIGHT_MODEL=openai/gpt-oss-20b
REASONING_EFFORT=low
# judge: use a different model family than the agents
JUDGE_MODEL=qwen/qwen3.8-27b
EMBEDDING_MODEL=voyage-3.5

# RAG
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=getnet_kb
RETRIEVAL_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Voyage free tier is ~3 requests/min. If you get 429s, keep these values.
# With a payment method on file: sleep 0, batch 128.
INGEST_BATCH_SIZE=16
INGEST_SLEEP_SECONDS=21

# auth (JWT, HS256). The app refuses to start if JWT_SECRET is empty, shorter than 32
# characters or looks like a placeholder. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret-of-32-or-more-chars
JWT_ISSUER=getnet-support-demo
JWT_AUDIENCE=getnet-support-api

# app
LOG_LEVEL=INFO
